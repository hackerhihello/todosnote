{
  "openapi": "3.0.0",
  "info": {
    "title": "Modern Todo Manager API",
    "version": "1.0.0",
    "description": "REST API for managing Todos, powered by Next.js and Convex.\n\nHere you can find the API definitions. Below are the basic cURL commands for you to try locally or on Vercel."
  },
  "servers": [
    {
      "url": "https://todosnote.vercel.app",
      "description": "Production server"
    },
    {
      "url": "/",
      "description": "Local server"
    }
  ],
  "components": {
    "schemas": {
      "Todo": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "dueDate": {
            "type": "number",
            "description": "Unix timestamp"
          },
          "completed": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "number"
          },
          "updatedAt": {
            "type": "number"
          }
        }
      },
      "CreateTodoInput": {
        "type": "object",
        "required": ["title", "priority"],
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"],
            "default": "Medium"
          },
          "dueDate": {
            "type": "number"
          }
        }
      },
      "UpdateTodoInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": ["Low", "Medium", "High"]
          },
          "dueDate": {
            "type": "number"
          },
          "completed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/api/todos": {
      "get": {
        "summary": "Get all Todos",
        "description": "Fetch all todos with optional filtering, sorting, and searching.\n\n**cURL Example:**\n```bash\ncurl -X GET \"https://todosnote.vercel.app/api/todos\"\n```",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["All", "Active", "Completed"]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["Newest First", "Oldest First"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of todos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Todo"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new Todo",
        "description": "Create a new todo by providing a title and priority.\n\n**cURL Example:**\n```bash\ncurl -X POST \"https://todosnote.vercel.app/api/todos\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\n           \"title\": \"Buy groceries\",\n           \"description\": \"Milk, Eggs, and Bread\",\n           \"priority\": \"High\"\n         }'\n```",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTodoInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/api/todos/{id}": {
      "get": {
        "summary": "Get a Todo by ID",
        "description": "Fetch a specific todo using its ID.\n\n**cURL Example:**\n```bash\ncurl -X GET \"https://todosnote.vercel.app/api/todos/<YOUR_TODO_ID>\"\n```",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The Todo object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Todo"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a Todo",
        "description": "Update specific fields of a todo or mark it as completed.\n\n**cURL Example:**\n```bash\ncurl -X PUT \"https://todosnote.vercel.app/api/todos/<YOUR_TODO_ID>\" \\\n     -H \"Content-Type: application/json\" \\\n     -d '{\"completed\": true}'\n```",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTodoInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete a Todo",
        "description": "Permanently delete a specific todo.\n\n**cURL Example:**\n```bash\ncurl -X DELETE \"https://todosnote.vercel.app/api/todos/<YOUR_TODO_ID>\"\n```",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted successfully"
          }
        }
      }
    }
  }
}
